# Игнорируем файл с секретными паролями и токенами
.env

# Игнорируем папку виртуального окружения (она весит много мегабайт и у каждого своя)
.venv/
venv/

# Игнорируем служебный кэш Python и pytest (создается автоматически при запуске)
__pycache__/
.pytest_cache/

# Игнорируем локальный файл с сохраненным расписанием (это временные данные программы)
schedule_cache.json